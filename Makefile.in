# Makefile for winless (generated from Makefile.in by ./configure)
PACKAGE = @PACKAGE_TARNAME@
VERSION = @PACKAGE_VERSION@
srcdir = @srcdir@
VPATH = @srcdir@
prefix = @prefix@
exec_prefix = @exec_prefix@
bindir = @bindir@
datarootdir = @datarootdir@
datadir = @datadir@
mandir = @mandir@
pkgdatadir = $(datadir)/$(PACKAGE)
CC = @CC@
CFLAGS = @CFLAGS@
CPPFLAGS = @CPPFLAGS@
LDFLAGS = @LDFLAGS@
LIBS = @LIBS@
INSTALL = @INSTALL@
INSTALL_PROGRAM = @INSTALL_PROGRAM@
INSTALL_DATA = @INSTALL_DATA@

WARN = -Wall -Wextra -Wpedantic
DEFS = -D_POSIX_C_SOURCE=200809L -DPACKAGE_VERSION=\"$(VERSION)\" -DPKGDATADIR=\"$(pkgdatadir)\"
SRCS = main.c client.c server.c remote.c json.c util.c edit.c edits.c llm.c store.c
OBJS = main.o client.o server.o remote.o json.o util.o edit.o edits.o llm.o store.o
DIST_FILES = main.c client.c server.c remote.c json.c util.c edit.c edits.c llm.c store.c winless.h viewer.html winless.1 sshw.1 configure configure.ac Makefile.in \
             install-sh README COPYING AUTHORS NEWS ChangeLog INSTALL tests/testlib.h tests/testlib.c tests/test_unit.c \
             tests/test_server.c tests/test_cli.c tests/test_revise.c tests/test_remote.c

all: winless remote-stamp winless-src.tar.gz

winless: $(OBJS)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $(OBJS) $(LIBS)

# A static build for this platform, which `sshw` uploads to hosts that have no winless (remote/<Os>-<machine>/winless).  It is optional:
# without libc.a and libsqlite3.a it is skipped, and sshw then works only on hosts that already have winless.
remote-stamp: $(SRCS) winless.h
	@key=`uname -sm | tr ' ' '-'`; mkdir -p remote/$$key; \
	if $(CC) -std=c11 -static $(DEFS) $(CPPFLAGS) $(CFLAGS) -o remote/$$key/winless $(SRCS) $(LIBS) -lpthread -ldl >/dev/null 2>&1; then \
	  echo "built remote/$$key/winless (what sshw uploads to hosts without winless)"; \
	else rm -rf remote; echo "note: no static build here (needs libc.a and libsqlite3.a); sshw will work only on hosts that already have winless"; fi; \
	touch remote-stamp

# The sources, for `sshw` to build winless on a host that has a C compiler but no binary from us (it then keeps the result in its archive).
winless-src.tar.gz: $(SRCS) winless.h viewer.html
	tar czf $@ -C $(srcdir) $(SRCS) winless.h viewer.html

%.o: %.c winless.h Makefile
	$(CC) -std=c11 $(WARN) $(DEFS) $(CPPFLAGS) $(CFLAGS) -c -o $@ $<

# The tests are C programs (tests/*.c): unit tests of json.c/util.c, and black-box tests that start the real winless
# binary.  `make check` builds and runs them; sh only invokes them.
TEST_PROGS = tests/test_unit tests/test_server tests/test_cli tests/test_revise tests/test_remote
TEST_OBJS = tests/testlib.o

tests/%.o: tests/%.c tests/testlib.h winless.h Makefile
	@mkdir -p tests
	$(CC) -std=c11 $(WARN) $(DEFS) -I$(srcdir) -I$(srcdir)/tests $(CPPFLAGS) $(CFLAGS) -c -o $@ $<

tests/test_unit: tests/test_unit.o $(TEST_OBJS) json.o util.o edit.o edits.o llm.o
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ tests/test_unit.o $(TEST_OBJS) json.o util.o edit.o edits.o llm.o $(LIBS)
tests/test_server: tests/test_server.o $(TEST_OBJS) json.o util.o
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ tests/test_server.o $(TEST_OBJS) json.o util.o $(LIBS)
tests/test_cli: tests/test_cli.o $(TEST_OBJS) json.o util.o
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ tests/test_cli.o $(TEST_OBJS) json.o util.o $(LIBS)
tests/test_revise: tests/test_revise.o $(TEST_OBJS) json.o util.o
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ tests/test_revise.o $(TEST_OBJS) json.o util.o $(LIBS)
tests/test_remote: tests/test_remote.o $(TEST_OBJS) json.o util.o
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ tests/test_remote.o $(TEST_OBJS) json.o util.o $(LIBS)

RUN_TESTS = for t in $(TEST_PROGS); do echo "== $$t"; WINLESS_BIN=$(CURDIR)/winless WINLESS_HTML=$(srcdir)/viewer.html ./$$t || exit 1; done

# The viewer page is one big script; a syntax error in it would break every window, so check it when node is available.
check-viewer:
	@if command -v node >/dev/null 2>&1; then \
	  awk '/<script>/{f=1;next} /<\/script>/{f=0} f' $(srcdir)/viewer.html > viewer.check.js && node --check viewer.check.js && echo "ok   viewer script syntax"; rc=$$?; rm -f viewer.check.js; exit $$rc; \
	else echo "skip viewer script syntax (no node)"; fi

check: winless winless-src.tar.gz check-viewer $(TEST_PROGS)
	@$(RUN_TESTS)

# the same tests with the program and the tests built with AddressSanitizer + UBSan
check-asan:
	$(MAKE) clean
	$(MAKE) CFLAGS="-g -O1 -fsanitize=address,undefined -fno-omit-frame-pointer" LDFLAGS="-fsanitize=address,undefined" winless $(TEST_PROGS)
	@ASAN_OPTIONS=detect_leaks=0; export ASAN_OPTIONS; $(RUN_TESTS)
	$(MAKE) clean

install: all
	$(srcdir)/install-sh -d $(DESTDIR)$(bindir) $(DESTDIR)$(pkgdatadir) $(DESTDIR)$(mandir)/man1
	$(INSTALL_PROGRAM) winless $(DESTDIR)$(bindir)/winless
	$(INSTALL_DATA) $(srcdir)/viewer.html $(DESTDIR)$(pkgdatadir)/viewer.html
	$(INSTALL_DATA) $(srcdir)/winless.1 $(DESTDIR)$(mandir)/man1/winless.1
	$(INSTALL_DATA) $(srcdir)/sshw.1 $(DESTDIR)$(mandir)/man1/sshw.1
	$(INSTALL_DATA) winless-src.tar.gz $(DESTDIR)$(pkgdatadir)/winless-src.tar.gz
	ln -sf winless $(DESTDIR)$(bindir)/sshw
	for d in remote/*/; do [ -f "$${d}winless" ] || continue; \
	  $(srcdir)/install-sh -d $(DESTDIR)$(pkgdatadir)/$${d}; $(INSTALL_PROGRAM) "$${d}winless" $(DESTDIR)$(pkgdatadir)/$${d}winless; done

uninstall:
	rm -f $(DESTDIR)$(bindir)/winless $(DESTDIR)$(bindir)/sshw $(DESTDIR)$(mandir)/man1/winless.1 $(DESTDIR)$(mandir)/man1/sshw.1
	rm -rf $(DESTDIR)$(pkgdatadir)

dist:
	rm -rf $(PACKAGE)-$(VERSION)
	mkdir -p $(PACKAGE)-$(VERSION)/tests
	for f in $(DIST_FILES); do cp -p $(srcdir)/$$f $(PACKAGE)-$(VERSION)/$$f; done
	tar czf $(PACKAGE)-$(VERSION).tar.gz $(PACKAGE)-$(VERSION)
	rm -rf $(PACKAGE)-$(VERSION)
	@echo "created $(PACKAGE)-$(VERSION).tar.gz"

clean:
	rm -f winless $(OBJS) $(TEST_PROGS) tests/*.o remote-stamp winless-src.tar.gz
	rm -rf remote

distclean: clean
	rm -f Makefile config.log config.status $(PACKAGE)-*.tar.gz
	rm -rf autom4te.cache

.PHONY: check-viewer all check check-asan install uninstall dist clean distclean
